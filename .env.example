# PostgreSQL Connection URL
DATABASE_URL=postgresql://epochforge:epochforge_secret@db:5432/epochforge

# Better Auth Secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-32-byte-better-auth-secret-key-here
BETTER_AUTH_URL=https://epochforge.example.com

# 32-Byte Secret for AES-256-GCM encryption of system settings & OAuth secrets
APP_ENCRYPTION_KEY=your-32-byte-aes-encryption-key-for-secrets-32ch

# Server Port
PORT=3000
NODE_ENV=production
ORIGIN=https://epochforge.example.com
